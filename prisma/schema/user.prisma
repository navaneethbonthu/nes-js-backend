
enum Role{
   USER
   ADMIN
}


model User {

  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String   
  password       String
  role            Role     @default(USER)
  profileImage    String?
  refreshToken    String?


  resetPasswordToken   String?   // Hashed token
  resetPasswordExpires   DateTime?

  
  createAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

}